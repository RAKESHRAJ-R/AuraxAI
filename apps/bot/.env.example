# Server Configuration
PORT=3000

# WooCommerce API Credentials
WOOCOMMERCE_URL=https://theaurax.in
WOOCOMMERCE_CONSUMER_KEY=your_key_here
WOOCOMMERCE_CONSUMER_SECRET=your_secret_here
# Alternative credential for the SAME wc/v3 endpoints, used in preference to the
# consumer key when both are set. Needed because a plugin on the store 401s every
# request carrying a recognised consumer key. Run `npm run check-woo` to see which works.
WOOCOMMERCE_APP_USER=
WOOCOMMERCE_APP_PASSWORD=

# AI Service Configuration
GROQ_API_KEY=your_groq_key_here          # Required — primary provider (comma-separate for multiple keys)
GROQ_MODEL=                              # Optional — defaults to llama-3.3-70b-versatile
SARVAM_API_KEY=                          # Optional — Tanglish-first paid provider (comma-sep for multiple)
SARVAM_MODEL=                            # Optional — defaults to sarvam-105b (sarvam-30b is RETIRED, returns 400)
FIREWORKS_API_KEY=                       # Optional — paid fallback
OPENROUTER_API_KEY=                      # Optional — fallback
OPENAI_API_KEY=your_openai_key_here

# --- Knowledge-source semantic search (embeddings) ---
# local  = all-MiniLM-L6-v2 on CPU (default). No key, no quota, no cost, nothing leaves
#          the server. ~130 MB RSS, ~17ms per indexed chunk, ~5ms per customer query.
# openai = text-embedding-3-small; needs a FUNDED OPENAI_API_KEY (the current key returns
#          429 quota-exceeded, which is why local is the default).
# Switching providers changes the vector width — existing sources must be re-indexed.
EMBEDDING_PROVIDER=local
# Where the ONNX model is cached. Must be writable by the user the app runs as.
EMBEDDING_CACHE_DIR=./.models
# Preload the model at boot so the first customer question doesn't pay the load time.
# Automatically skipped when no knowledge sources are indexed. Set false to disable.
EMBEDDING_WARMUP=true
GEMINI_API_KEY=your_gemini_key_here

# Database — unset = JSON files in src/data/ (fallback).
# Atlas:       mongodb+srv://user:pass@cluster.mongodb.net/theaurax_assistant
# Self-hosted: mongodb://theaurax:PASSWORD@127.0.0.1:27017/theaurax_assistant?authSource=theaurax_assistant
MONGODB_URI=

# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here

# Owner Configuration (for bulk order notifications)
OWNER_WHATSAPP_NUMBER=+919940954744
OWNER_INSTAGRAM_ID=
BULK_ORDER_THRESHOLD=20


# WATI WhatsApp API integration
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
ALLOWED_TEST_NUMBERS=+919940954744,+917708435288

# Self-Hosted WhatsApp Web Linked Device Integration
WHATSAPP_WEB_ENABLED=false

# Host base URL for dynamic invoice PDF download links
BASE_URL=http://localhost:3000
GOOGLE_SHEETS_ID=

# Admin console accounts — every person signs in with their own email + password, and their
# role decides which pages they can open. These two create the FIRST Owner account, once, on a
# boot where no accounts exist yet; after that they are ignored and staff are managed from the
# Users & Roles page. Lost the Owner password? `npm run admin-user -- --email ... --password ...`
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
ADMIN_OWNER_NAME=
# How long a console sign-in lasts, in hours (default 168 = 7 days).
ADMIN_SESSION_TTL_HOURS=168
# Legacy shared password. Only used as the first Owner's password when ADMIN_OWNER_PASSWORD is empty.
AURAX_TEAM_PASSWORD=

# Brevo transactional email — sends new staff their login details automatically.
# Optional: without it, the console shows the details on screen for the owner to share.
# MAIL_FROM_EMAIL must be a verified sender in Brevo, and the domain needs Brevo's SPF/DKIM
# records or the emails land in spam.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Aurax Admin
# Sign-in link used in those emails (normally the Vercel URL). Defaults to BASE_URL/admin.
ADMIN_CONSOLE_URL=

# Origins allowed to call this API cross-origin (comma-separated, no trailing slash).
# REQUIRED for the Vercel-hosted admin console — it runs on a different origin than this
# server, so without its URL here the browser blocks every admin API response.
# An entry may be an exact origin, or `*.`-prefixed to match a suffix — use the latter for
# Vercel preview deploys, whose hostnames are generated per commit.
# Leave empty if you only use the self-hosted /admin build (same origin, no CORS needed).
#   e.g. ADMIN_ALLOWED_ORIGINS=https://aurax-admin.vercel.app,*.vercel.app
ADMIN_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# WhatsApp ban protection
# ---------------------------------------------------------------------------
# whatsapp-web.js is an UNOFFICIAL client. WhatsApp restricts numbers that look
# automated, and it measures per ACCOUNT, not per chat. On 2026-09-17 the live
# number was restricted ("spam, automated or bulk messaging") minutes after the
# client paired a phone that had a large unread backlog: the catch-up sweep
# answered all of it at once, which from WhatsApp's side is a broadcast.
#
# The defaults below are deliberately timid. Raise them only with evidence, and
# only one at a time.

# Minimum gap between ANY two outbound messages, plus random jitter on top.
WA_MIN_SEND_GAP_MS=4000
WA_SEND_JITTER_MS=3000
# Hard ceiling over a rolling 60 seconds.
WA_MAX_SENDS_PER_MIN=8
# Hard ceiling on DISTINCT chats contacted in a rolling hour. This is the number
# that actually reflects "bulk messaging" — 8/min is also 480/hour, which is a
# campaign however politely it is spaced. Bulk paths (catch-up drip, cold-lead
# follow-ups) check this and hold off; live customer replies are never blocked.
WA_MAX_NEW_CHATS_PER_HOUR=30

# ---------------------------------------------------------------------------
# Missed-message catch-up
# ---------------------------------------------------------------------------
# Answers customers who wrote while the bot was down, or who were already unread
# when the phone was paired. Set CATCHUP_ENABLED=false to switch it off entirely.
CATCHUP_ENABLED=true
# ⚠️ Set this to true the FIRST time you point the bot at a real phone. It sweeps
# and prints exactly who it would answer, and messages nobody. Always check the
# report before letting it send.
CATCHUP_DRY_RUN=false
# On the very first sweep of a number (no watermark yet) look back only this far.
# Without it, a freshly paired phone treats its ENTIRE history as unanswered —
# that is what caused the 2026-09-17 restriction. 0 = sweep everything (unsafe).
CATCHUP_COLD_START_HOURS=24
# Customers who wrote within this window are answered on reconnect...
CATCHUP_FRESH_HOURS=12
# ...but at most this many back-to-back. The rest join the slow drip below.
CATCHUP_FRESH_MAX_IMMEDIATE=5
# Never answer a message older than this. 0 = no limit (answers months-old chats,
# which reads as cold outreach rather than a reply). 2 = "only people who wrote in
# the last day or two", which is what the store owner asked for: older chats often
# concern orders that were already sorted out by hand.
CATCHUP_MAX_AGE_DAYS=2
# Drip rate for the older backlog, per hour.
CATCHUP_DRAIN_PER_HOUR=20
CATCHUP_ALERT_OWNER=true

# ---------------------------------------------------------------------------
# Cold-lead follow-ups
# ---------------------------------------------------------------------------
# The ONLY feature that messages someone who did not just write to us — i.e. it
# "starts new chats", the exact capability WhatsApp revokes first. Turn it off
# while a number is restricted or newly warmed up.
FOLLOWUP_ENABLED=true
FOLLOWUP_INACTIVE_HOURS=3
FOLLOWUP_MAX_PER_LEAD=2
FOLLOWUP_MAX_PER_RUN=8
# Minimum gap between two nudges to the SAME person. Without it the second one
# lands on the next 30-minute run, because eligibility is measured from the
# CUSTOMER's last message and our own nudge does not move it.
FOLLOWUP_COOLDOWN_HOURS=24
# Never nudge a lead whose last activity is older than this. 0 = no limit.
FOLLOWUP_MAX_LEAD_AGE_DAYS=3

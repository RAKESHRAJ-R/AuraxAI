# Server Configuration
PORT=3000

# WooCommerce API Credentials
WOOCOMMERCE_URL=https://theaurax.in
WOOCOMMERCE_CONSUMER_KEY=your_key_here
WOOCOMMERCE_CONSUMER_SECRET=your_secret_here

# AI Service Configuration
GROQ_API_KEY=your_groq_key_here          # Required — primary provider (comma-separate for multiple keys)
GROQ_MODEL=                              # Optional — defaults to llama-3.3-70b-versatile
SARVAM_API_KEY=                          # Optional — Tanglish-first paid provider
FIREWORKS_API_KEY=                       # Optional — paid fallback
OPENROUTER_API_KEY=                      # Optional — fallback
OPENAI_API_KEY=your_openai_key_here

# --- Knowledge-source semantic search (embeddings) ---
# local  = all-MiniLM-L6-v2 on CPU (default). No key, no quota, no cost, nothing leaves
#          the server. ~130 MB RSS, ~17ms per indexed chunk, ~5ms per customer query.
# openai = text-embedding-3-small; needs a FUNDED OPENAI_API_KEY (the current key returns
#          429 quota-exceeded, which is why local is the default).
# Switching providers changes the vector width — existing sources must be re-indexed.
EMBEDDING_PROVIDER=local
# Where the ONNX model is cached. Must be writable by the user the app runs as.
EMBEDDING_CACHE_DIR=./.models
# Preload the model at boot so the first customer question doesn't pay the load time.
# Automatically skipped when no knowledge sources are indexed. Set false to disable.
EMBEDDING_WARMUP=true
GEMINI_API_KEY=your_gemini_key_here

# Database — unset = JSON files in src/data/ (fallback).
# Atlas:       mongodb+srv://user:pass@cluster.mongodb.net/theaurax_assistant
# Self-hosted: mongodb://theaurax:PASSWORD@127.0.0.1:27017/theaurax_assistant?authSource=theaurax_assistant
MONGODB_URI=

# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here

# Owner Configuration (for bulk order notifications)
OWNER_WHATSAPP_NUMBER=+919940954744
OWNER_INSTAGRAM_ID=
BULK_ORDER_THRESHOLD=20


# WATI WhatsApp API integration
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
ALLOWED_TEST_NUMBERS=+919940954744,+917708435288

# Self-Hosted WhatsApp Web Linked Device Integration
WHATSAPP_WEB_ENABLED=false

# Host base URL for dynamic invoice PDF download links
BASE_URL=http://localhost:3000
GOOGLE_SHEETS_ID=

# Admin console access — one shared password per team. Whoever enters a password
# is tagged with that team in the console. Set at least one to enable login.
AURAX_TEAM_PASSWORD=
TESTING_TEAM_PASSWORD=
# Legacy single password — still works, treated as the Aurax team if the two above are unset.
KNOWLEDGE_HUB_PASSWORD=